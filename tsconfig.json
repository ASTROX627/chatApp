{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": "./backend/src/",
    "outDir": "./backend/dist" ,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["backend/src/**/*"],
  "exclude": ["node_modules"]
}
